PORT=4000
ALLOWED_ORIGINS=http://localhost:5173

# Confusion Tracking Configuration
THRESHOLD_PERCENT=25
WINDOW_SEC=120
DEBOUNCE_SEC=20
COOLDOWN_SEC=180

# Security Configuration
JWT_SIGNING_SECRET=dev-secret-change-in-production
SESSION_TIMEOUT=300
MAX_REQUESTS_PER_MIN=60
MAX_CONFUSION_PER_USER=3
ENFORCE_HTTPS=false

# Application URLs
FRONTEND_BASE_URL=http://localhost:5173
TOOL_BASE_URL=http://localhost:4000

# LTI 1.3 Platform Configuration (configure for Moodle/Canvas)
PLATFORM_ISSUER=https://moodle.example.edu
PLATFORM_CLIENT_ID=bluenote-lti
PLATFORM_AUTH_LOGIN_URL=https://moodle.example.edu/mod/lti/auth.php
PLATFORM_JWKS_URL=https://moodle.example.edu/.well-known/jwks.json
PLATFORM_DEPLOYMENT_ID=1

# Tool Keys (for JWT signing and JWKS)
# Generate with: openssl genpkey -algorithm RSA -out private.key -pkcs8 -aes256
LTI_PRIVATE_KEY_PEM=
LTI_KID=bluenote-key-1

# Database URLs (for Redis and PostgreSQL integration)
REDIS_URL=redis://localhost:6379
POSTGRES_DSN=postgresql://bluenote:bluenote@localhost:5432/bluenote
REDIS_MAX_CONNECTIONS=20
POSTGRES_MAX_SIZE=10

