PORT=4000
ALLOWED_ORIGIN=http://localhost:5173

THRESHOLD_PERCENT=25
WINDOW_SEC=120
DEBOUNCE_SEC=20
COOLDOWN_SEC=180

# LTI Gateway (configure for Moodle later)
# FRONTEND_BASE defaults to ALLOWED_ORIGIN
FRONTEND_BASE=
PLATFORM_ISSUER=
PLATFORM_CLIENT_ID=
PLATFORM_AUTH_LOGIN_URL=
PLATFORM_JWKS_URL=
PLATFORM_DEPLOYMENT_ID=
TOOL_REDIRECT_URI=http://localhost:4000/lti/launch

# Tool keys (for JWKS). If empty, an ephemeral key is generated at startup (dev only).
LTI_PRIVATE_KEY_PEM=
LTI_KID=
